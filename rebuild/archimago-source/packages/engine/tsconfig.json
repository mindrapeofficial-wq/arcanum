{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "commonjs",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "target": "esnext",
    "paths": {
      "shared/*": [
        "../../shared/*"
      ],
      "data/*": [
        "../../data/*"
      ],
      "data-adapter/*": [
        "../../data-adapter/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "tests",
    "dist",
    "node_modules"
  ]
}
